/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://img.shields.io; font-src 'self' data:; connect-src 'self' https://api.gumroad.com blob: data:; media-src 'self' blob: data:; worker-src 'self' blob:; child-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()
  X-Frame-Options: DENY
  Cache-Control: public, max-age=0, must-revalidate
  Vary: Accept

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: public, max-age=0, no-cache, no-store, must-revalidate

/precache-manifest.json
  Cache-Control: public, max-age=0, no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: public, max-age=3600, must-revalidate

/tools.json
  Cache-Control: public, max-age=3600, must-revalidate

/llms.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate
  Vary: Accept
  Access-Control-Allow-Origin: *

/llms.txt
  Cache-Control: public, max-age=3600, must-revalidate

/*.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate
  Vary: Accept
  Access-Control-Allow-Origin: *

/tools/*.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate
  Vary: Accept
  Access-Control-Allow-Origin: *
